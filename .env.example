VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Optional HR Master Database used by the “Sync ข้อมูล” button.
VITE_MASTERDATABASE_API_KEY=your-master-database-api-key
VITE_MASTERDATABASE_AUTH_DOMAIN=your-master-project.firebaseapp.com
VITE_MASTERDATABASE_PROJECT_ID=your-master-project-id
VITE_MASTERDATABASE_STORAGE_BUCKET=your-master-project.firebasestorage.app
VITE_MASTERDATABASE_MESSAGING_SENDER_ID=your-master-sender-id
VITE_MASTERDATABASE_APP_ID=your-master-app-id
VITE_MASTERDATABASE_MEASUREMENT_ID=your-master-measurement-id

# ZKBioTime attendance (server-side only; copy these three into functions/.env for deploy).
ZK_API_BASE_URL=http://your-biotime-server
ZK_API_USERNAME=your-username
ZK_API_PASSWORD=your-password

# Dev only: forward /api/zkteco to the deployed site (remove to call ZKBioTime directly).
# ZK_DEV_PROXY_URL=https://your-site.web.app
